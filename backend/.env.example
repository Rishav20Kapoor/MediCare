# MongoDB connection string for the application database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Comma-separated public URLs for the patient and admin portals
CLIENT_ORIGINS=https://your-patient-portal.vercel.app,https://your-admin-portal.vercel.app
FRONTEND_URL=https://your-patient-portal.vercel.app

# Server-side Clerk and doctor-session configuration
CLERK_SECRET_KEY=
JWT_SECRET=
MAJOR_ADMIN_ID=

# Razorpay payments (optional unless online payments are enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary credentials (if image uploads are enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
